{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="publication-search">
    <label for="bibsearch">Search publications</label>
    <input
      type="search"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="Title, author, venue, or year"
      aria-describedby="bibsearch-status"
    >
    <p id="bibsearch-status" class="search-status" role="status" aria-live="polite"></p>
  </div>
{% endif %}
