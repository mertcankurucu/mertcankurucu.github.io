<header>
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="Main navigation"
  >
    <div class="container site-nav-inner">
      <a class="navbar-brand" href="{{ '/' | relative_url }}">
        {{- site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name -}}
      </a>
      <button
        class="navbar-toggler collapsed"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span>Menu</span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          <li class="nav-item{% if page.permalink == '/' %} active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}
                aria-current="page"
              {% endif %}
              >Home</a
            >
          </li>
          {% assign navigation_pages = site.pages | sort: 'nav_order' %}
          {% for item in navigation_pages %}
            {% if item.nav and item.autogen == null %}
              <li class="nav-item{% if page.url == item.url %} active{% endif %}">
                <a
                  class="nav-link"
                  href="{{ item.url | relative_url }}"
                  {% if page.url == item.url %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- item.title -}}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
      <div class="nav-controls">
        {% if site.search_enabled %}
          <button id="search-toggle" type="button" title="Search" aria-label="Search the site" onclick="openSearchModal()">
            <i class="ti ti-search" aria-hidden="true"></i>
          </button>
        {% endif %}
        {% if site.enable_darkmode %}
          <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
            <i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
            <i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i>
            <i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
          </button>
        {% endif %}
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0" aria-label="Reading progress">
      <div class="progress-container"><span class="progress-bar"></span></div>
    </progress>
  {% endif %}
</header>
