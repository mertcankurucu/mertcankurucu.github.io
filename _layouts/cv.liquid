---
layout: default
---
{% assign resume = site.data.resume %}
<article class="post web-cv">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
    <p>
      <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a> ·
      <a href="{{ '/publications/' | relative_url }}">Publications</a> · <a href="{{ '/teaching/' | relative_url }}">Teaching</a>
    </p>
  </header>
  {% if resume %}
    {% assign sections = site.jsonresume %}
    {% for section in sections %}
      {% if resume[section].size > 0 %}
        <section class="cv-section" aria-labelledby="cv-{{ section }}">
          <h2 id="cv-{{ section }}">
            {% case section -%}
              {%- when 'work' -%}
                Research experience
              {%- when 'education' -%}
                Education
              {%- when 'service' -%}
                Academic service & recognition
              {%- when 'funding' -%}
                Funding
              {%- when 'awards' -%}
                Publication awards
            {%- endcase %}
          </h2>
          <dl class="cv-entries">
            {% for entry in resume[section] %}
              <div class="cv-entry">
                <dt class="cv-period">{% include resume/period.liquid entry=entry %}</dt>
                <dd>
                  <h3>
                    {% if entry.position -%}
                      {{- entry.position -}}
                    {%- elsif entry.studyType -%}
                      {{- entry.studyType }}, {{ entry.area -}}
                    {%- else -%}
                      {{- entry.title -}}
                    {%- endif %}
                  </h3>
                  {% assign institution = entry.name | default: entry.institution | default: entry.awarder %}
                  {% if institution %}
                    <p class="cv-institution">
                      {% if entry.url -%}
                        <a href="{{ entry.url }}">{{ institution }}</a>
                      {%- else -%}
                        {{- institution -}}
                      {%- endif %}
                    </p>
                  {% endif %}
                  {% if entry.summary %}
                    <p>{{ entry.summary }}</p>
                  {% endif %}
                  {% if entry.highlights.size > 0 %}
                    <ul>
                      {% for highlight in entry.highlights %}
                        <li>{{ highlight }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </dd>
              </div>
            {% endfor %}
          </dl>
        </section>
      {% endif %}
    {% endfor %}
  {% endif %}
</article>
