---
layout: default
---
<article class="academic-home">
  <div class="intro-grid">
    <header class="intro-heading">
      <h1>
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}
      </h1>
      <p class="intro-role">{{ page.subtitle }}</p>
      {% include contact_links.liquid %}
    </header>
    {% if page.profile.image %}
      <div class="intro-portrait">
        {% assign portrait = page.profile.image | prepend: 'assets/img/' %}
        {% include figure.liquid path=portrait loading="eager" width=page.profile.width height=page.profile.height sizes="(max-width: 640px) 144px, 230px" alt="Mert Can Kurucu" %}
      </div>
    {% endif %}
    <div class="intro-prose">{{ content }}</div>
  </div>

  {% if page.announcements.enabled %}
    <section class="home-section" aria-labelledby="news-heading">
      <div class="section-heading">
        <h2 id="news-heading">News</h2>
        <a href="{{ '/news/' | relative_url }}">All news <span aria-hidden="true">→</span></a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="home-section" aria-labelledby="publications-heading">
      <div class="section-heading">
        <h2 id="publications-heading">Selected publications</h2>
        <a href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">→</span></a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}
</article>
