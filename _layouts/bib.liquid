---
---
{% assign presentation = site.data.featured_publications | where: 'key', entry.key | first %}
{% assign figure_available = false %}
{% if presentation.image and presentation.alt and presentation.width and presentation.height %}
  {% capture figure_exists %}{% file_exists {{presentation.image}} %}{% endcapture %}
  {% if figure_exists == 'true' %}{% assign figure_available = true %}{% endif %}
{% endif %}
{% assign paper_url = '' %}
{% if entry.doi %}
  {% assign paper_url = entry.doi | prepend: 'https://doi.org/' %}
{% elsif entry.url %}
  {% assign paper_url = entry.url %}
{% elsif entry.arxiv %}
  {% assign paper_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' %}
{% elsif entry.html contains '://' %}
  {% assign paper_url = entry.html %}
{% endif %}
<article
  id="{{ entry.key }}"
  class="publication-row{% if figure_available %} publication-with-figure{% endif %}"
  aria-labelledby="{{ entry.key }}-title"
>
  {% if figure_available %}
    <figure class="publication-figure">
      <img
        src="{{ presentation.image | relative_url }}"
        alt="{{ presentation.alt | escape }}"
        width="{{ presentation.width }}"
        height="{{ presentation.height }}"
        loading="lazy"
      >
    </figure>
  {% endif %}
  <div class="publication-content">
    <h3 class="publication-title" id="{{ entry.key }}-title">
      {% if paper_url != '' -%}
        <a href="{{ paper_url }}">{{ entry.title }}</a>
      {%- else -%}
        {{- entry.title -}}
      {%- endif %}
    </h3>
    <p class="publication-authors">
      {% for author in entry.author_array %}
        {%- unless forloop.first %}, {% endunless -%}
        {%- if site.scholar.last_name contains author.last and site.scholar.first_name contains author.first -%}
          <strong>
            {{- author.first }}
            {{ author.last -}}
          </strong>
        {%- else -%}
          {{ author.first }}
          {{ author.last }}
        {%- endif -%}
      {% endfor %}
    </p>
    <p class="publication-venue">
      {% if entry.journal %}{{ entry.journal }}{% elsif entry.booktitle %}{{ entry.booktitle }}{% elsif entry.eprint %}Preprint{% endif %}
      {% if entry.year %} · {{ entry.year }}{% endif %}
      {% if entry.note %} · {{ entry.note }}{% endif %}
    </p>
    {% if presentation.summary %}
      <p class="publication-summary">{{ presentation.summary }}</p>
    {% endif %}
    <div class="publication-resources">
      {% if paper_url != '' -%}
        <a href="{{ paper_url }}"
          >Paper<span class="sr-only">: {{ entry.title }}</span></a
        >
      {%- endif %}
      {% if entry.code -%}
        <a href="{{ entry.code }}"
          >Code<span class="sr-only">: {{ entry.title }}</span></a
        >
      {%- endif %}
      {% if entry.website -%}
        <a href="{{ entry.website }}"
          >Project<span class="sr-only">: {{ entry.title }}</span></a
        >
      {%- endif %}
      {% assign local_resources = 'pdf,poster,slides,supp' | split: ',' %}
      {% for resource in local_resources %}
        {% assign resource_url = entry[resource] %}
        {% if resource_url %}
          {% assign resource_available = false %}
          {% if resource_url contains '://' %}
            {% assign resource_available = true %}
          {% else %}
            {% assign resource_path = resource_url | prepend: 'assets/pdf/' %}
            {% capture resource_exists %}{% file_exists {{resource_path}} %}{% endcapture %}
            {% if resource_exists == 'true' %}
              {% assign resource_available = true %}
              {% assign resource_url = resource_path | relative_url %}
            {% endif %}
          {% endif %}
          {% if resource_available %}
            <a href="{{ resource_url }}">
              {%- if resource == 'pdf' %}PDF{% elsif resource == 'supp' %}Supplement{% else %}{{ resource | capitalize }}{% endif -%}
              <span class="sr-only">: {{ entry.title }}</span></a
            >
          {% endif %}
        {% endif %}
      {% endfor %}
      {% if entry.abstract %}
        <details class="publication-detail">
          <summary>
            Abstract<span class="sr-only">: {{ entry.title }}</span>
          </summary>
          <div class="publication-detail-content">{{ entry.abstract | markdownify }}</div>
        </details>
      {% endif %}
      <details class="publication-detail">
        <summary>
          BibTeX<span class="sr-only">: {{ entry.title }}</span>
        </summary>
        <pre class="publication-detail-content"><code>{{ entry.bibtex | hideCustomBibtex | escape }}</code></pre>
      </details>
    </div>
  </div>
</article>
